{
  "extends": ["stylelint-config-standard"],
  "plugins": ["stylelint-declaration-strict-value"],
  "rules": {
    "scale-unlimited/declaration-strict-value": [
      ["/color/", "fill", "stroke", "font-size", "z-index"],
      {
        "ignoreValues": {
          "/color/": ["transparent", "inherit", "currentColor", "none", "unset", "initial"],
          "fill": ["transparent", "inherit", "currentColor", "none"],
          "stroke": ["transparent", "inherit", "currentColor", "none"],
          "font-size": ["inherit", "unset", "initial"],
          "z-index": ["auto", "inherit", "-1", "0", "1"]
        },
        "expandShorthand": true,
        "recurseLonghand": true,
        "severity": "error",
        "message": "Use a CSS variable (var(--...)) instead of a hardcoded value for '%s'"
      }
    ],
    "color-no-invalid-hex": true,
    "declaration-no-important": [true, { "severity": "warning" }],
    "selector-class-pattern": null,
    "keyframes-name-pattern": null,
    "media-feature-range-notation": null,
    "color-function-notation": null,
    "color-function-alias-notation": null,
    "alpha-value-notation": null,
    "color-hex-length": null,
    "import-notation": null,
    "property-no-vendor-prefix": null,
    "rule-empty-line-before": null,
    "comment-empty-line-before": null,
    "no-descending-specificity": null,
    "declaration-block-no-redundant-longhand-properties": null,
    "custom-property-empty-line-before": null,
    "value-keyword-case": null,
    "block-no-empty": null,
    "no-empty-source": null,
    "declaration-empty-line-before": null,
    "property-no-deprecated": null
  },
  "ignoreFiles": ["node_modules/**", "dist/**", "build/**", ".vite/**"]
}
